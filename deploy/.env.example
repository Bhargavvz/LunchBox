# Copy to /opt/lunchbox/.env on the server (never commit the real one) and fill in. `chmod 600 .env`.
# Generate passwords/keys with:  openssl rand -base64 32

# ---- Domains and image (the deploy workflow sets BACKEND_IMAGE on every deploy) ----
API_DOMAIN=api.lunchbox.in
ADMIN_DOMAIN=admin.lunchbox.in
BACKEND_IMAGE=ghcr.io/owner/repo/backend:latest

# ---- Memory (m7i-flex.large, 8 GB). For a 2 GB t3.small delete these four lines to use the small defaults. ----
BACKEND_JAVA_OPTS=-Xms512m -Xmx3g -XX:MaxMetaspaceSize=256m
POSTGRES_SHARED_BUFFERS=1GB
REDIS_MAXMEMORY=256mb
DB_POOL_SIZE=20

# ---- Database, cache, queue (only used inside the server) ----
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBIT_PASSWORD=

# ---- App keys: generate once, keep a copy offline. Losing the PII key makes encrypted data unreadable. ----
LUNCHBOX_PII_KEY=
LUNCHBOX_QR_SIGNING_KEY=

# ---- Firebase (sign-in + push) ----
GOOGLE_CLOUD_PROJECT=lunchboxappv1
# The whole service-account JSON on ONE line, inside single quotes.
FIREBASE_CREDENTIALS_JSON=

# ---- Handover photos: Firebase Storage bucket (security rules closed; the backend signs URLs with the key above) ----
STORAGE_BUCKET=lunchboxappv1.firebasestorage.app

# ---- Razorpay (payments, always live in prod): test keys first, live keys at launch ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional providers: "off" until you have accounts ----
RAZORPAYX_MODE=off
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
MSG91_MODE=off
MSG91_AUTH_KEY=
SENTRY_DSN=

# First run only: the email that becomes super admin (also add it in Firebase > Authentication > Users). Then empty it.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
