{
  "name": "lunchbox",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev:infra": "docker compose up -d",
    "dev:backend": "cd backend && ./gradlew bootRun --args=--spring.profiles.active=local",
    "dev:admin": "pnpm --filter @lunchbox/admin dev",
    "dev:parent": "pnpm --filter @lunchbox/parent start",
    "dev:partner": "pnpm --filter @lunchbox/partner start",
    "generate:api": "pnpm --filter @lunchbox/api-client generate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@lunchbox/config": "workspace:*",
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "metro": "0.83.3",
      "metro-babel-transformer": "0.83.3",
      "metro-cache": "0.83.3",
      "metro-cache-key": "0.83.3",
      "metro-config": "0.83.3",
      "metro-core": "0.83.3",
      "metro-file-map": "0.83.3",
      "metro-minify-terser": "0.83.3",
      "metro-resolver": "0.83.3",
      "metro-runtime": "0.83.3",
      "metro-source-map": "0.83.3",
      "metro-symbolicate": "0.83.3",
      "metro-transform-plugins": "0.83.3",
      "metro-transform-worker": "0.83.3"
    }
  }
}
