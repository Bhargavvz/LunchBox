vpc_cidr             = "10.30.0.0/16"
db_instance_class    = "db.r7g.xlarge"
db_allocated_storage = 200
redis_node_type      = "cache.r7g.large"
mq_instance_type     = "mq.m5.large"
backend_image        = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/lunchbox-prod/backend:latest-sha"
backend_cpu          = 2048
backend_memory       = 4096
backend_min_tasks    = 3
backend_max_tasks    = 20
route53_zone_id      = "Z0000000000000"
api_domain           = "api.lunchbox.in"
admin_domain         = "admin.lunchbox.in"
api_certificate_arn  = "arn:aws:acm:ap-south-1:123456789012:certificate/..."
admin_certificate_arn_us_east_1 = "arn:aws:acm:us-east-1:123456789012:certificate/..."
firebase_project_id  = "lunchbox-prod"
alert_emails         = ["oncall@lunchbox.in"]
