vpc_cidr             = "10.10.0.0/16"
db_instance_class    = "db.t4g.medium"
db_allocated_storage = 50
redis_node_type      = "cache.t4g.small"
mq_instance_type     = "mq.t3.micro"
backend_image        = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/lunchbox-dev/backend:latest-sha"
backend_cpu          = 1024
backend_memory       = 2048
backend_min_tasks    = 1
backend_max_tasks    = 3
route53_zone_id      = "Z0000000000000"
api_domain           = "api.dev.lunchbox.in"
admin_domain         = "admin.dev.lunchbox.in"
api_certificate_arn  = "arn:aws:acm:ap-south-1:123456789012:certificate/..."
admin_certificate_arn_us_east_1 = "arn:aws:acm:us-east-1:123456789012:certificate/..."
firebase_project_id  = "lunchbox-dev"
alert_emails         = ["oncall@lunchbox.in"]
