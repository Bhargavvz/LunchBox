# Local development against the docker-compose backend (Android emulator reaches the host at 10.0.2.2).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8080/ws
EXPO_PUBLIC_FAKE_PAYMENTS=true
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
# Paths to Firebase config files (store them as EAS file secrets, never commit them)
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist

# Local sign-in through the Firebase Auth emulator from docker-compose (host:port reachable from the device).
# Leave empty to use the real Firebase project from GOOGLE_SERVICES_JSON.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR=10.0.2.2:9099

# Real project on an emulator: true lets only the console's test phone numbers sign in, skipping Play Integrity.
# Development builds only; ignored in release builds.
EXPO_PUBLIC_FIREBASE_TEST_NUMBERS_ONLY=false

# Builds not installed from Google Play: verify phone sign-in with reCAPTCHA instead of Play Integrity.
# Keep true for emulators and EAS preview APKs; production (Play Store) builds set it to false in eas.json.
EXPO_PUBLIC_FIREBASE_FORCE_RECAPTCHA=true
