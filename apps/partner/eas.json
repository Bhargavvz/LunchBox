{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "GOOGLE_SERVICES_JSON": "./google-services.local.json",
        "EXPO_PUBLIC_FIREBASE_FORCE_RECAPTCHA": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://api.staging.lunchbox.in",
        "EXPO_PUBLIC_WS_URL": "wss://api.staging.lunchbox.in/ws",
        "EXPO_PUBLIC_FIREBASE_FORCE_RECAPTCHA": "true"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.lunchbox.in",
        "EXPO_PUBLIC_WS_URL": "wss://api.lunchbox.in/ws",
        "EXPO_PUBLIC_FIREBASE_FORCE_RECAPTCHA": "false"
      }
    },
    "apk": {
      "extends": "production",
      "distribution": "internal",
      "channel": "apk",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.18-211-99-232.sslip.io",
        "EXPO_PUBLIC_WS_URL": "wss://api.18-211-99-232.sslip.io/ws",
        "EXPO_PUBLIC_FAKE_PAYMENTS": "false",
        "EXPO_PUBLIC_FIREBASE_FORCE_RECAPTCHA": "true"
      },
      "environment": "production"
    },
    "playstore": {
      "extends": "production",
      "channel": "playstore",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.18-211-99-232.sslip.io",
        "EXPO_PUBLIC_WS_URL": "wss://api.18-211-99-232.sslip.io/ws",
        "EXPO_PUBLIC_FAKE_PAYMENTS": "false",
        "EXPO_PUBLIC_FIREBASE_FORCE_RECAPTCHA": "false"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./play-service-account.json"
      },
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
