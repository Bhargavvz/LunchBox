{
  "name": "@lunchbox/partner",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "jest",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production"
  },
  "dependencies": {
    "@lunchbox/api-client": "workspace:*",
    "@lunchbox/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "23.4.0",
    "@react-native-firebase/auth": "23.4.0",
    "@react-native-firebase/messaging": "23.4.0",
    "@tanstack/react-query": "5.59.15",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.9",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.13",
    "expo-file-system": "~19.0.17",
    "expo-image-manipulator": "~14.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.10",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.7",
    "i18next": "23.16.4",
    "react": "19.1.0",
    "react-i18next": "15.1.0",
    "react-native": "0.81.4",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "3.23.8",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.25.8",
    "@lunchbox/config": "workspace:*",
    "@testing-library/react-native": "12.8.1",
    "@types/jest": "29.5.13",
    "@types/react": "19.1.10",
    "eslint": "9.13.0",
    "jest": "29.7.0",
    "jest-expo": "~54.0.12",
    "typescript": "5.6.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-firebase|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@lunchbox/.*))"
    ],
    "setupFiles": ["<rootDir>/jest.setup.ts"]
  }
}
